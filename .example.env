# HTTP 入口只有 NFX-Edge；本栈不跑 Traefik。


# LAN publish address. GRPC_HOST_* defaults to this machine; point one key at NAS2 when that service moves.
NAS_IP=192.168.1.64
HTTP_EXT_PORT_S3=10080
HTTP_EXT_PORT_ADMIN=10082
HTTP_EXT_PORT_OBJECT=10084
HTTP_EXT_PORT_IAM=10086
HTTP_EXT_PORT_NOTIFY=10088
GRPC_EXT_PORT_AUTH=10031
HTTP_PORT=8080
CONSOLE_PORT=80
CONSOLE_EXTERNAL_PORT=10090
VITE_PORT=5176
VITE_API_URL=/dev/nfx-storages
VITE_BASE=/dev/console/nfx-storages/
VITE_IDENTITY_API_URL=/dev/nfx-identity
VITE_API_BASE_URL=/dev/nfx-storages/admin/v3
VITE_S3_ENDPOINT=http://192.168.1.64:10012

GRPC_PORT_S3=50072
GRPC_PORT_OBJECT=50073
GRPC_PORT_IAM=50074
GRPC_PORT_ADMIN=50075
GRPC_PORT_NOTIFY=50076

GRPC_EXT_PORT_S3=10081
GRPC_EXT_PORT_OBJECT=10085
GRPC_EXT_PORT_IAM=10087
GRPC_EXT_PORT_ADMIN=10083
GRPC_EXT_PORT_NOTIFY=10089

GRPC_HOST_AUTH=192.168.1.64
GRPC_HOST_S3=192.168.1.64
GRPC_HOST_OBJECT=192.168.1.64
GRPC_HOST_IAM=192.168.1.64
GRPC_HOST_ADMIN=192.168.1.64
GRPC_HOST_NOTIFY=192.168.1.64

POSTGRESQL_HOST=192.168.1.64
POSTGRESQL_PORT=10004
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your-postgresql-password-here
POSTGRESQL_NAME_DEV=nfxstorages_dev
POSTGRESQL_NAME_PROD=nfxstorages
POSTGRESQL_NAME_SHADOW=nfxstorages_diff
POSTGRES_SSLMODE=disable
POSTGRES_CONTAINER_NAME=NFX-Stack-PostgreSQL
ATLAS_POSTGRES_HOST=192.168.1.64
ATLAS_POSTGRES_PORT=10004

REDIS_HOST=192.168.1.64
REDIS_PORT=10006
REDIS_PASSWORD=your-redis-password-here

KAFKA_BROKERS=192.168.1.64:10008
OTEL_EXPORTER_OTLP_ENDPOINT=192.168.1.64:10016

TOKEN_SECRET_KEY=your-secret-key-here-change-in-production
TOKEN_ISSUER=nfxidentity
TOKEN_ACCESS_TTL=24h
TOKEN_REFRESH_TTL=168h
TOKEN_ALGORITHM=HS256

STORAGES_VOLUME_0=/your-nas/nfxstorages/disk0
STORAGES_VOLUME_1=/your-nas/nfxstorages/disk1
STORAGES_VOLUME_2=/your-nas/nfxstorages/disk2
STORAGES_VOLUME_3=/your-nas/nfxstorages/disk3
