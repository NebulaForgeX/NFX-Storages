# ENV=secure example for NFX-Storages (copy to .secure.env). Same keys as .example.env; attach nfx-edge, no extra Traefik.
# HTTP 入口只有 NFX-Edge；本栈不跑 Traefik。
TRAEFIK_API_HOST=storages-api.example.com
TRAEFIK_S3_HOST=s3.example.com
TRAEFIK_CONSOLE_HOST=storages.example.com

API_PREFIX_PATH_ADMIN=/nfxstorages/admin/v3
API_PREFIX_PATH_OBJECT=/nfxstorages/object
API_PREFIX_PATH_IAM=/nfxstorages/iam
API_PREFIX_PATH_NOTIFY=/nfxstorages/notify
API_PREFIX_PATH_SYSTEM=/system

HTTP_PORT=8080
CONSOLE_PORT=80
CONSOLE_EXTERNAL_PORT=10133
VITE_API_URL=https://storages-api.example.com
VITE_IDENTITY_API_URL=https://api.example.com
VITE_SERVER_HOST=https://storages-api.example.com
VITE_API_BASE_URL=https://storages-api.example.com/nfxstorages/admin/v3
VITE_S3_ENDPOINT=https://s3.example.com

GRPC_PORT_AUTH=10156
GRPC_PORT_S3=10134
GRPC_PORT_OBJECT=10135
GRPC_PORT_IAM=10136
GRPC_PORT_ADMIN=10137
GRPC_PORT_NOTIFY=10138
GRPC_PORT_SYSTEM=10139
GRPC_HOST_AUTH=192.168.1.64
GRPC_HOST_S3=192.168.1.64
GRPC_HOST_OBJECT=192.168.1.64
GRPC_HOST_IAM=192.168.1.64
GRPC_HOST_ADMIN=192.168.1.64
GRPC_HOST_NOTIFY=192.168.1.64
GRPC_HOST_SYSTEM=192.168.1.64

POSTGRESQL_HOST=172.18.0.6
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your-postgresql-password-here
POSTGRESQL_NAME_DEV=nfxstorages_dev
POSTGRESQL_NAME_PROD=nfxstorages
POSTGRESQL_NAME_SHADOW=nfxstorages_diff
POSTGRES_SSLMODE=disable
POSTGRES_CONTAINER_NAME=NFX-Stack-PostgreSQL
ATLAS_POSTGRES_HOST=192.168.1.64
ATLAS_POSTGRES_PORT=10105

REDIS_HOST=192.168.1.64
REDIS_PORT=10181
REDIS_PASSWORD=your-redis-password-here
KAFKA_BROKERS=192.168.1.64:10183
OTEL_EXPORTER_OTLP_ENDPOINT=192.168.1.64:10192

TOKEN_SECRET_KEY=your-secret-key-here-change-in-production
TOKEN_ISSUER=nfxidentity
TOKEN_ACCESS_TTL=24h
TOKEN_REFRESH_TTL=168h
TOKEN_ALGORITHM=HS256

STORAGES_VOLUME_0=/your-nas/nfxstorages/disk0
STORAGES_VOLUME_1=/your-nas/nfxstorages/disk1
STORAGES_VOLUME_2=/your-nas/nfxstorages/disk2
STORAGES_VOLUME_3=/your-nas/nfxstorages/disk3
